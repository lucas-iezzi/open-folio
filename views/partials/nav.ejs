<nav class="site-nav" role="navigation" aria-label="Main navigation">
  <div class="container">
    <div class="nav-inner">

      <%# Left: small logo slot (hidden by default, shown via sandbox CSS) %>
      <div class="nav-logo-small">
        <% if (typeof logoSmallSrc !== 'undefined' && logoSmallSrc) { %>
        <a href="/" aria-label="Home"><img src="<%= logoSmallSrc %>" alt="Logo" draggable="false"></a>
        <% } %>
      </div>

      <%# Center: logomark slot (hidden by default, shown via sandbox CSS) %>
      <div class="nav-logo-mark">
        <% if (typeof logoMarkSrc !== 'undefined' && logoMarkSrc) { %>
        <a href="/" aria-label="Home"><img src="<%= logoMarkSrc %>" alt="Logomark" draggable="false"></a>
        <% } %>
      </div>

      <%# Right: desktop links + mobile hamburger %>
      <div class="nav-right">
        <div class="nav-links-desktop">
          <a href="/">Home</a>
        </div>
        <button
          id="nav-hamburger"
          class="nav-hamburger"
          aria-controls="nav-menu"
          aria-expanded="false"
          aria-label="Open navigation menu"
        >
          <span aria-hidden="true"></span>
          <span aria-hidden="true"></span>
          <span aria-hidden="true"></span>
        </button>
      </div>

    </div>
  </div>
</nav>

<div id="nav-menu" class="nav-menu" role="dialog" aria-label="Navigation menu" aria-modal="true">
  <a href="/">Home</a>
</div>
