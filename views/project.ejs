<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/head') %>
  <% if (typeof sandboxCss !== 'undefined' && sandboxCss) { %>
  <style><%- sandboxCss %></style>
  <% } else if (typeof hasSandboxStyle !== 'undefined' && hasSandboxStyle) { %>
  <link rel="stylesheet" href="/sandbox-active.css?page=<%= project.slug %>">
  <% } %>
  <title><%= project.title %> — Lucas Iezzi</title>
  <meta name="description" content="<%= project.subtitle || project.title %>">
</head>
<body>
  <%- include('partials/nav') %>

  <main>
    <%- include('partials/project-body', { project: project }) %>
  </main>

  <%- include('partials/footer') %>
  <script src="/js/main.js" defer></script>
</body>
</html>
