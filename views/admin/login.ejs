<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/head') %>
  <title>Admin Login — Lucas Iezzi</title>
</head>
<body>
  <div class="login-page">
    <div class="login-card">

      <span class="login-logo">lucas iezzi</span>

      <h1 class="login-title">Admin</h1>
      <p class="login-subtitle">Sign in to manage your portfolio.</p>

      <% if (error) { %>
      <div class="login-error" role="alert"><%= error %></div>
      <% } %>

      <form method="POST" action="/admin/login" autocomplete="on" novalidate>
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">

        <div class="login-field">
          <label for="password">Password</label>
          <input
            type="password"
            id="password"
            name="password"
            autocomplete="current-password"
            required
            autofocus
          >
        </div>

        <button type="submit" class="btn btn-primary login-submit">Sign in</button>
      </form>

    </div>
  </div>
</body>
</html>
