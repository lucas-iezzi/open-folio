<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/head') %>
  <title>Sandbox Preview</title>
  <style><%- sandboxCss %></style>
</head>
<body>
  <%- include('partials/nav') %>

  <main>
    <div class="container">

      <section class="hero" aria-label="Introduction">
        <% if (typeof logoSmallSrc !== 'undefined' && logoSmallSrc) { %>
        <div class="hero-logo-small"><img src="<%= logoSmallSrc %>" alt="Logo" draggable="false"></div>
        <% } %>
        <% if (typeof logoMarkSrc !== 'undefined' && logoMarkSrc) { %>
        <div class="hero-logo-mark"><img src="<%= logoMarkSrc %>" alt="Logomark" draggable="false"></div>
        <% } %>
        <h1 class="site-name"><%- sandboxHeroName || 'lucas<br>iezzi' %></h1>
        <p class="hero-text">
          <% if (sandboxHeroTagline) { %><%= sandboxHeroTagline %><% } else { %>I am a creative problem solver <span class="highlight">crafting</span> products that are engineered for enjoyment<% } %>
        </p>
      </section>

      <% if (projects.length > 0) { %>
      <section aria-label="Portfolio projects">
        <div class="project-grid" role="list">
          <% projects.forEach(function(project) { %>
          <article role="listitem">
            <a
              class="project-card"
              href="/projects/<%= project.slug %>"
              aria-label="<%= project.title %>"
            >
              <div class="project-card-image">
                <% if (project.thumbnail) { %>
                  <img
                    src="<%= project.thumbnail %>"
                    alt="<%= project.thumbnailAlt || project.title %>"
                    loading="lazy"
                    decoding="async"
                  >
                <% } else { %>
                  <div class="project-card-placeholder" aria-hidden="true"></div>
                <% } %>
              </div>
              <h2 class="project-card-title"><%= project.title %></h2>
            </a>
          </article>
          <% }); %>
        </div>
      </section>
      <% } %>

    </div>
  </main>

  <%- include('partials/footer') %>
  <script src="/js/main.js" defer></script>
</body>
</html>
